# --- opsgraph local-only planning docs (never pushed, always kept locally) ---
PLAN.md
AGENTS.md

# --- Build artifacts (NEVER commit binaries; ship via GitHub Releases only) ---
/bin/
/binaries/
/dist/
/dist-release/
*.exe
*.out
*.test
cover.out
coverage.*
**/testdata/fuzz/
# Precompiled release archives must not enter the source tree.
*.tar.gz
*.zip
SHA256SUMS
DEPENDENCIES.txt

# --- Runtime data / SQLite state ---
/.opsgraph/
# Default pack name from `opsgraph pack`.
/*.opsgraph
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Go ---
# Keep go.mod and go.sum tracked; ignore vendored deps if any.
/vendor/

# --- Editor / OS noise ---
.idea/
*.swp
.DS_Store
Thumbs.db
